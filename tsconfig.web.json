{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.tsx",
    "${configDir}/src/**/*.vue",
    "${configDir}/vite.config.ts"
  ]
}
