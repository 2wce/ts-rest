{
  "name": "ts-rest",
  "version": "0.2.0",
  "license": "MIT",
  "scripts": {
    "version-packages": "changeset version",
    "version-packages-update-lockfile": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "vp run build && node tools/vite/release-workspace.mjs && cd dist && node ../node_modules/@changesets/cli/bin.js publish",
    "build": "vp run --filter \"./libs/ts-rest/*\" pack",
    "build:examples": "vp run --filter \"example-*\" build",
    "test": "vp run unit-tests",
    "test:watch": "vp run watch-tests",
    "test:packages": "node tools/vite/package-check.mjs",
    "test:hosts": "vp run host-tests",
    "typecheck": "vp run --no-cache --filter \"./libs/ts-rest/*\" --filter @ts-rest/non-strict-mode-test --filter @ts-rest/build-config typecheck",
    "lint": "vp run lint-workspace",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp run check-workspace",
    "nest": "vp run example-nest#dev",
    "docs:build": "vp run @ts-rest/docs#build",
    "docs:start": "vp run @ts-rest/docs#start",
    "example-microservice:serve": "vp run --parallel --filter \"example-microservice-*\" dev",
    "ts-rest:build-watch": "vp run --parallel --filter \"./libs/ts-rest/*\" pack -- --watch",
    "build-test-all": "vp run build && vp run check && vp run test:packages && vp run build:examples",
    "examples:generate": "vp run @ts-rest/example-database#generate",
    "docs:dev": "vp run @ts-rest/docs#dev"
  },
  "engines": {
    "pnpm": "12.14.0",
    "node": "26.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "repository": "https://github.com/ts-rest/ts-rest",
  "private": true,
  "devDependencies": {
    "@anatine/zod-openapi": "catalog:",
    "@azure/functions": "catalog:",
    "@changesets/cli": "catalog:",
    "@fetch-mock/vitest": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/testing": "catalog:",
    "@openapi-contrib/json-schema-to-openapi-schema": "catalog:",
    "@swc/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/solid-query": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "azure-functions-core-tools": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "itty-router": "catalog:",
    "jsdom": "catalog:",
    "multer": "catalog:",
    "next": "catalog:",
    "openapi3-ts": "catalog:",
    "parse-multipart-data": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "supertest": "catalog:",
    "ts-deepmerge": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "typescript-legacy": "npm:typescript@5.2.2",
    "unplugin-swc": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:",
    "zod4": "catalog:",
    "esbuild": "catalog:",
    "@ts-rest/build-config": "workspace:*"
  },
  "volta": {
    "node": "26.12.0"
  }
}
