{
  "name": "ts-rest",
  "version": "0.2.0",
  "license": "MIT",
  "scripts": {
    "version-packages": "changeset version",
    "version-packages-update-lockfile": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm build && node tools/vite/release-workspace.mjs && cd dist && node ../node_modules/@changesets/cli/bin.js publish",
    "build": "vp run --filter \"./libs/ts-rest/*\" pack",
    "build:examples": "vp run --filter \"example-*\" --filter \"web-app-*\" build",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:packages": "node tools/vite/package-check.mjs",
    "test:hosts": "vp test run --config vite.hosts.config.ts",
    "typecheck": "tsc --noEmit -p tools/vite/tsconfig.assertions.json && tsc --noEmit -p tools/vite/tsconfig.non-strict.json && tsc --noEmit -p libs/ts-rest/express/tsconfig.assertions.json && tsc --noEmit -p libs/ts-rest/next/tsconfig.assertions.json && tsc --noEmit -p libs/ts-rest/nest/tsconfig.assertions.json && tsc --noEmit -p libs/ts-rest/react-query/tsconfig.assertions.json && tsc --noEmit -p libs/ts-rest/react-query-v5/tsconfig.assertions.json",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm typecheck",
    "nest": "pnpm --filter example-nest dev",
    "docs:build": "bun --cwd apps/docs run build",
    "docs:start": "bun --cwd apps/docs run dev",
    "example-microservice:serve": "vp run --parallel --filter \"example-microservice-*\" --filter \"web-app-*\" dev",
    "ts-rest:build-watch": "vp run --parallel --filter \"./libs/ts-rest/*\" pack -- --watch",
    "postinstall": "pnpm prisma generate",
    "build-test-all": "pnpm build && pnpm check && pnpm test:packages && pnpm build:examples"
  },
  "engines": {
    "pnpm": "12.14.0",
    "node": "26.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "repository": "https://github.com/ts-rest/ts-rest",
  "private": true,
  "dependencies": {
    "@anatine/zod-openapi": "2.0.1",
    "@azure/functions": "^4.5.0",
