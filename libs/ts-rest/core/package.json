{
  "name": "@ts-rest/core",
  "version": "3.52.1",
  "private": false,
  "description": "RPC-like experience over a regular REST API, with type safe server implementations \ud83e\ude84",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-rest/ts-rest.git",
    "directory": "libs/ts-rest/core"
  },
  "license": "MIT",
  "peerDependencies": {
    "@types/node": "^18.18.7 || >=20.8.4",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./zod3": "./src/zod3.ts"
  },
  "devDependencies": {
    "@ts-rest/build-config": "workspace:*",
    "zod-legacy": "npm:zod@3.22.3",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./zod3": {
        "import": {
          "types": "./dist/zod3.esm.d.mts",
          "default": "./dist/zod3.esm.mjs"
        },
        "require": {
          "types": "./dist/zod3.cjs.d.ts",
          "default": "./dist/zod3.cjs.js"
        }
      }
    },
    "typesVersions": {
      "*": {
        "zod3": [
          "./dist/zod3.cjs.d.ts"
        ]
      }
    }
  },
  "typesVersions": {
    "*": {
      "zod3": [
        "./src/zod3.ts"
      ]
    }
  }
}
