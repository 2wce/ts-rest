{
  "name": "@ts-rest/express",
  "version": "3.52.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-rest/ts-rest.git",
    "directory": "libs/ts-rest/express"
  },
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "@ts-rest/core": "workspace:^",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "devDependencies": {
    "@ts-rest/core": "workspace:*",
    "@ts-rest/build-config": "workspace:*",
    "zod": "catalog:"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./zod3": "./src/zod3.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./zod3": {
        "import": {
          "types": "./dist/zod3.esm.d.mts",
          "default": "./dist/zod3.esm.mjs"
        },
        "require": {
          "types": "./dist/zod3.cjs.d.ts",
          "default": "./dist/zod3.cjs.js"
        }
      }
    },
    "typesVersions": {
      "*": {
        "zod3": [
          "./dist/zod3.cjs.d.ts"
        ]
      }
    }
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "zod3": [
        "./src/zod3.ts"
      ]
    }
  }
}
