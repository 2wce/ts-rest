{
  "name": "@ts-restless/nest",
  "version": "4.0.0-alpha.2",
  "private": false,
  "description": "ts-restless nest integration for contract-first, end-to-end typed REST.",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "nestjs",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/nest"
  },
  "license": "MIT",
  "devDependencies": {
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "fastify": "5.12.7",
    "@ts-restless/core": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@ts-restless/build-config": "workspace:*",
    "zod": "catalog:",
    "zod-legacy": "npm:zod@3.22.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "rxjs": "^7.1.0",
    "@ts-restless/core": "workspace:^",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./zod3": "./src/zod3.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./zod3": {
        "import": {
          "types": "./dist/zod3.esm.d.mts",
          "default": "./dist/zod3.esm.mjs"
        },
        "require": {
          "types": "./dist/zod3.cjs.d.ts",
          "default": "./dist/zod3.cjs.js"
        }
      }
    },
    "typesVersions": {
      "*": {
        "zod3": [
          "./dist/zod3.cjs.d.ts"
        ]
      }
    }
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "zod3": [
        "./src/zod3.ts"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme"
}
