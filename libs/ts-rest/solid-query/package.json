{
  "name": "@ts-rest/solid-query",
  "version": "3.52.1",
  "private": false,
  "description": "solid-query client integration for @ts-rest",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "solid-query",
    "nestjs",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-rest/ts-rest.git",
    "directory": "libs/ts-rest/solid-query"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/solid-query": "^4.0.0",
    "@ts-rest/core": "workspace:^"
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@ts-rest/core": "workspace:*",
    "@ts-rest/build-config": "workspace:*"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      }
    }
  }
}
