{
  "name": "@ts-restless/solid-query",
  "version": "3.52.1",
  "private": false,
  "description": "ts-restless solid-query integration for contract-first, end-to-end typed REST.",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "solid-query",
    "nestjs",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/solid-query"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/solid-query": "^4.0.0",
    "@ts-restless/core": "workspace:^"
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@ts-restless/core": "workspace:*",
    "@ts-restless/build-config": "workspace:*"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme"
}
