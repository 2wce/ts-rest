{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "source.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
